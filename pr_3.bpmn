<svg xmlns="http://www.w3.org/2000/svg"
     width="1650" height="2080" viewBox="0 0 1650 2080">

  <defs>
    <marker id="arrow"
            markerWidth="10" markerHeight="8"
            refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8" fill="#334d66"/>
    </marker>
  </defs>

  <style>
    text {
      font-family: Arial, sans-serif;
      font-size: 21px;
      fill: #172b43;
      text-anchor: middle;
    }
    .small { font-size: 19px; }
    .heading { font-size: 22px; font-weight: bold; }
    .task {
      fill: white;
      stroke: #334d66;
      stroke-width: 2;
    }
    .flow {
      fill: none;
      stroke: #334d66;
      stroke-width: 2.4;
      stroke-linejoin: round;
      marker-end: url(#arrow);
    }
    .event {
      fill: white;
      stroke: #334d66;
      stroke-width: 2;
    }
    .end { stroke-width: 4.5; }
    .gateway {
      fill: #fff5de;
      stroke: #334d66;
      stroke-width: 2;
    }
    .cross {
      fill: none;
      stroke: #334d66;
      stroke-width: 3;
    }
  </style>

  <rect width="1650" height="2080" fill="white"/>

  <!-- Заголовок -->
  <text x="825" y="42" style="font-size:28px;font-weight:bold">
    Организация концерта музыкального коллектива
  </text>
  <text x="825" y="77">
    BPMN 2.0 · Инициатор процесса — сам коллектив
  </text>

  <!-- Общий пул -->
  <rect x="40" y="105" width="1560" height="1845"
        fill="white" stroke="#7890a5" stroke-width="2"/>

  <text transform="translate(76 1028) rotate(-90)">
    Организация деятельности музыкального коллектива
  </text>

  <!-- Дорожки участников -->
  <rect x="100" y="105" width="440" height="1845"
        fill="#f3f8ff" stroke="#a5b5c4"/>
  <rect x="540" y="105" width="640" height="1845"
        fill="#f7f9fc" stroke="#a5b5c4"/>
  <rect x="1180" y="105" width="420" height="1845"
        fill="#f3faf8" stroke="#a5b5c4"/>

  <path d="M100,195 H1600" stroke="#a5b5c4"/>

  <text class="heading" x="320" y="142">
    <tspan x="320">Музыкальный</tspan>
    <tspan x="320" dy="26">коллектив</tspan>
  </text>

  <text class="heading" x="860" y="157">
    Администратор
  </text>

  <text class="heading" x="1390" y="142">
    <tspan x="1390">Информационная</tspan>
    <tspan x="1390" dy="26">система</tspan>
  </text>

  <!-- Стрелки последовательности -->
  <path class="flow" d="M350,247 V310"/>
  <path class="flow" d="M470,355 H1250"/>
  <path class="flow" d="M1390,400 V510 H890"/>
  <path class="flow" d="M750,555 V664"/>

  <!-- Условия не найдены -->
  <path class="flow" d="M786,700 H920"/>
  <text class="small" x="850" y="685">Нет</text>
  <path class="flow" d="M1030,745 V828"/>

  <!-- Условия найдены -->
  <path class="flow" d="M714,700 H350 V770"/>
  <text class="small" x="658" y="683">Да</text>
  <path class="flow" d="M350,860 V954"/>

  <!-- Замечания и возврат к подбору условий -->
  <path class="flow" d="M350,1026 V1120"/>
  <text class="small" x="382" y="1077">Нет</text>
  <path class="flow" d="M230,1165 H140 V510 H610"/>

  <!-- Согласование и подготовка -->
  <path class="flow" d="M386,990 H750 V1290"/>
  <text class="small" x="435" y="974">Да</text>
  <path class="flow" d="M890,1335 H1250"/>
  <path class="flow" d="M1390,1380 V1535 H890"/>
  <path class="flow" d="M610,1535 H470"/>

  <!-- Проведение и завершение -->
  <path class="flow" d="M350,1580 V1735 H610"/>
  <path class="flow" d="M890,1735 H1250"/>
  <path class="flow" d="M1390,1780 V1848"/>

  <!-- Начало процесса -->
  <circle class="event" cx="350" cy="225" r="22"/>
  <text class="small" x="215" y="224">
    <tspan x="215">Решение провести</tspan>
    <tspan x="215" dy="26">концерт</tspan>
  </text>

  <!-- Заявка коллектива -->
  <rect class="task" x="230" y="310"
        width="240" height="90" rx="13"/>
  <text x="350" y="349">
    <tspan x="350">Сформировать</tspan>
    <tspan x="350" dy="26">заявку на концерт</tspan>
  </text>

  <!-- Регистрация заявки -->
  <rect class="task" x="1250" y="310"
        width="280" height="90" rx="13"/>
  <text x="1390" y="349">
    <tspan x="1390">Зарегистрировать</tspan>
    <tspan x="1390" dy="26">заявку</tspan>
  </text>

  <!-- Подбор условий -->
  <rect class="task" x="610" y="465"
        width="280" height="90" rx="13"/>
  <text x="750" y="504">
    <tspan x="750">Подобрать площадку,</tspan>
    <tspan x="750" dy="26">дату и бюджет</tspan>
  </text>

  <!-- Первый исключающий шлюз -->
  <path class="gateway"
        d="M750,664 L786,700 L750,736 L714,700 Z"/>
  <path class="cross"
        d="M740,690 L760,710 M740,710 L760,690"/>
  <text class="small" x="965" y="607">
    Условия найдены?
  </text>

  <!-- Отмена концерта -->
  <rect class="task" x="920" y="655"
        width="220" height="90" rx="13"/>
  <text x="1030" y="694">
    <tspan x="1030">Сообщить причины</tspan>
    <tspan x="1030" dy="26">отмены</tspan>
  </text>

  <circle class="event end" cx="1030" cy="850" r="22"/>
  <text class="small" x="1030" y="907">
    Концерт отменён
  </text>

  <!-- Рассмотрение условий коллективом -->
  <rect class="task" x="230" y="770"
        width="240" height="90" rx="13"/>
  <text x="350" y="809">
    <tspan x="350">Рассмотреть</tspan>
    <tspan x="350" dy="26">условия концерта</tspan>
  </text>

  <!-- Второй исключающий шлюз -->
  <path class="gateway"
        d="M350,954 L386,990 L350,1026 L314,990 Z"/>
  <path class="cross"
        d="M340,980 L360,1000 M340,1000 L360,980"/>
  <text class="small" x="540" y="912">
    Условия согласованы?
  </text>

  <!-- Замечания коллектива -->
  <rect class="task" x="230" y="1120"
        width="240" height="90" rx="13"/>
  <text x="350" y="1172">Указать замечания</text>

  <!-- Договор -->
  <rect class="task" x="610" y="1290"
        width="280" height="90" rx="13"/>
  <text x="750" y="1329">
    <tspan x="750">Оформить договор</tspan>
    <tspan x="750" dy="26">с площадкой</tspan>
  </text>

  <!-- Сохранение данных -->
  <rect class="task" x="1250" y="1290"
        width="280" height="90" rx="13"/>
  <text x="1390" y="1329">
    <tspan x="1390">Сохранить концерт,</tspan>
    <tspan x="1390" dy="26">договор и задачи</tspan>
  </text>

  <!-- Подготовка -->
  <rect class="task" x="610" y="1490"
        width="280" height="90" rx="13"/>
  <text x="750" y="1529">
    <tspan x="750">Организовать репетиции</tspan>
    <tspan x="750" dy="26">и подготовку</tspan>
  </text>

  <!-- Проведение концерта -->
  <rect class="task" x="230" y="1490"
        width="240" height="90" rx="13"/>
  <text x="350" y="1542">Провести концерт</text>

  <!-- Подведение итогов -->
  <rect class="task" x="610" y="1690"
        width="280" height="90" rx="13"/>
  <text x="750" y="1729">
    <tspan x="750">Подвести итоги</tspan>
    <tspan x="750" dy="26">и внести расчёты</tspan>
  </text>

  <!-- Формирование отчёта -->
  <rect class="task" x="1250" y="1690"
        width="280" height="90" rx="13"/>
  <text x="1390" y="1729">
    <tspan x="1390">Сформировать отчёт</tspan>
    <tspan x="1390" dy="26">и закрыть концерт</tspan>
  </text>

  <!-- Завершение процесса -->
  <circle class="event end" cx="1390" cy="1870" r="22"/>
  <text class="small" x="1390" y="1927">
    Процесс завершён
  </text>

  <!-- Пояснения -->
  <text class="small" x="825" y="1992">
    Круг — событие начала или завершения; прямоугольник — задача;
  </text>
  <text class="small" x="825" y="2020">
    ромб с крестом — выбор одного пути; стрелка — последовательность выполнения.
  </text>
  <text class="small" x="825" y="2050">
    После замечаний коллектива администратор повторно подбирает условия концерта.
  </text>

</svg>
